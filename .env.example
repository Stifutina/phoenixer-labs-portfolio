# Telegram bot that posts contact form messages into the team's group.
# 1. Create a bot with @BotFather and copy its token.
# 2. Add the bot to the group, then send any message in the group.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the group's chat id
#    (negative, e.g. -5518300773; supergroups start with -100).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional, only if the group uses topics: the topic's message_thread_id
TELEGRAM_THREAD_ID=
