---
// Architecture of the anonymized AI commerce platform. Ice parts are the ones Sergey owned.
---
<figure class="diagram">
    <div class="diagram__grid">
        <div class="col">
            <p class="col__label">People</p>
            <div class="node">Store admins</div>
            <div class="node">Staff</div>
            <div class="node">Shoppers</div>
        </div>
        <div class="col">
            <p class="col__label">Access</p>
            <div class="node node--own">
                <strong>Auth and roles</strong>
                <span>BetterAuth sessions, role checks per tenant</span>
            </div>
        </div>
        <div class="col">
            <p class="col__label">Agents</p>
            <div class="node">Agent runtime <span>LLM calls, conversation</span></div>
            <div class="node node--own">
                <strong>MCP client</strong>
                <span>discovers and calls tools</span>
            </div>
            <div class="node node--own">
                <strong>MCP server</strong>
                <span>catalog-scoped search, document retrieval, Zod-typed contracts</span>
            </div>
        </div>
        <div class="col">
            <p class="col__label">Data</p>
            <div class="node node--own node--db">
                <strong>PostgreSQL + pgvector</strong>
                <span>tenants, users and roles</span>
                <span>multi-level product catalog</span>
                <span>tag taxonomies</span>
                <span>documents and their links</span>
                <span>embeddings</span>
                <span>Kysely migrations</span>
            </div>
        </div>
    </div>
    <figcaption><span class="mark mark--sergey"></span> Parts Sergey designed and built. Simplified; the client is under NDA.</figcaption>
</figure>

<style>
    .diagram {
        margin: 0;
        padding: clamp(1.25rem, 3vw, 2.25rem);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        background: radial-gradient(70% 90% at 80% 0%, rgba(143, 211, 255, 0.1), transparent 70%), var(--surface);
    }

    .diagram__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.75rem;
    }

    .col {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .col__label {
        font-size: 0.8rem;
        color: var(--muted);
    }

    .node {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        padding: 0.7rem 0.9rem;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: rgba(var(--night-rgb), 0.6);
        color: var(--soft);
        font-size: 0.95rem;
        line-height: 1.3;
    }

    .node span {
        font-size: 0.82rem;
        color: var(--muted);
    }

    .node--own {
        border-color: rgba(143, 211, 255, 0.5);
        box-shadow: 0 0 0 1px rgba(143, 211, 255, 0.08), 0 10px 30px -18px rgba(143, 211, 255, 0.6);
    }

    .node--own strong {
        color: var(--ice);
        font-weight: 600;
    }

    .node--own span {
        color: #a9c6dd;
    }

    figcaption {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 1.5rem;
        font-size: 0.88rem;
        color: var(--muted);
    }

    @media (min-width: 900px) {
        .diagram__grid {
            grid-template-columns: 0.8fr 1fr 1.15fr 1.1fr;
            gap: 2.25rem;
        }

        /* Connectors between columns */
        .col + .col::before {
            content: '';
            position: absolute;
            left: -2.25rem;
            top: 3.6rem;
            width: 2.25rem;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(143, 211, 255, 0.6));
        }
    }
</style>
