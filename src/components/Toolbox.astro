---
interface Props {
    groups: { name: string; items: string[] }[]
}

const { groups } = Astro.props
---
<section class="section wrap" aria-labelledby="tools-title">
    <h2 id="tools-title" class="section-title">Tools of the trade</h2>
    <dl class="tools">
        {groups.map((group) => (
            <div class="tools__group">
                <dt>{group.name}</dt>
                <dd>{group.items.join(', ')}</dd>
            </div>
        ))}
    </dl>
</section>

<style>
    .tools {
        display: grid;
        gap: 0;
        margin: 0;
        border-top: 1px solid var(--line);
    }

    .tools__group {
        display: grid;
        gap: 0.3rem 2rem;
        padding-block: 1.1rem;
        border-bottom: 1px solid var(--line);
    }

    dt {
        color: var(--accent);
        font-size: 0.95rem;
    }

    dd {
        margin: 0;
        color: var(--soft);
        font-size: var(--step-1);
        line-height: 1.4;
    }

    @media (min-width: 820px) {
        .tools__group {
            grid-template-columns: 1fr 3fr;
            align-items: baseline;
        }
    }
</style>
