---
import Arrow from './Arrow.astro'
import { people, type Owner } from '../data/site'

interface Props {
    owner?: Owner
    title?: string
}

const { owner, title = 'Tell us what you’re building.' } = Astro.props
const href = owner ? `/contact?with=${owner}` : '/contact'
const upwork = owner ? people[owner].upwork : undefined
---
<section class="band wrap" aria-labelledby="band-title">
    <h2 id="band-title" class="band__title">{title}</h2>
    <div class="band__side">
        <p>A few sentences are enough: what it is, where it stands, and what you need from us. {owner ? `It goes straight to ${people[owner].first}.` : 'Both of us read every message.'}</p>
        <div class="band__actions">
            <a class="pill pill--solid" href={href}>Start a project <Arrow /></a>
            {upwork && <a class="band__alt" href={upwork} rel="noopener">or hire on Upwork</a>}
        </div>
    </div>
</section>

<style>
    .band {
        display: grid;
        gap: 1.75rem;
        margin-top: clamp(6rem, 16vh, 11rem);
        padding-top: clamp(2.5rem, 6vh, 4rem);
        border-top: 1px solid var(--line);
    }

    .band__title {
        font-size: var(--step-4);
        line-height: 0.95;
        letter-spacing: -0.04em;
        max-width: 12ch;
    }

    .band__side {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 40ch;
        color: var(--soft);
        font-size: var(--step-1);
    }

    .band__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem 1.5rem;
    }

    .band__alt {
        color: var(--soft);
        font-size: 1rem;
        transition: color 0.2s;
    }

    .band__alt:hover {
        color: var(--accent);
    }

    @media (min-width: 900px) {
        .band {
            grid-template-columns: 7fr 4fr;
            align-items: end;
            column-gap: 4rem;
        }
    }
</style>
