<style>
    .logo {
        display: block;
        flex: none;
        overflow: visible;
    }

    .logo path {
        transition: fill 0.8s var(--ease), opacity 0.8s var(--ease), transform 0.8s var(--ease);
        transform-origin: 50% 50%;
    }

    .logo__upper {
        fill: #ffffff;
    }

    .logo__lower {
        fill: #4a63ff;
    }
</style>
